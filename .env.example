# Wordix Docker servislerinin local geliştirme ortamında beklediği değişkenleri belgeler.
# Gerçek parola ve API anahtarı bu dosyaya yazılmaz; `.env` içinde local olarak tutulur.

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

MSSQL_SA_PASSWORD=

AZURE_TRANSLATOR_SUBSCRIPTION_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
